# ---- Required ----
MONGO_URI=mongodb://127.0.0.1:27017/seedhaprint
JWT_SECRET=change-me-to-a-long-random-string

# Public addresses. Change them here only, then restart the API.
# WEB_URL goes into every QR code and is the only site allowed to call this API.
# Production: WEB_URL=https://seedhaprint.in  API_URL=https://api.seedhaprint.in
WEB_URL=http://localhost:3100
API_URL=http://localhost:4100
PORT=4100

# ---- Payments ----
# Each shop connects its own Razorpay account in its dashboard (Payments page).
# This key encrypts their secrets. Generate once with: openssl rand -hex 32
# Keep it safe: if it is lost or changed, every shop must reconnect Razorpay.
ENCRYPTION_KEY=

# Fake checkout that prints for free, for shops without Razorpay. On by default in
# development and OFF in production unless you set this to true for testing.
# ALLOW_TEST_CHECKOUT=true

# ---- File storage (default: local disk in ./storage) ----
# Set these for S3 / Cloudflare R2 / any S3-compatible store (needed when you run more than one API server)
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Hours to keep customer files after the job finishes (then they are deleted)
FILE_RETENTION_HOURS=24

# Optional: path to LibreOffice "soffice" to accept Word files (.doc/.docx)
SOFFICE_PATH=

# First admin account, created by `npm run seed`
ADMIN_PHONE=9999999999
ADMIN_PASSWORD=admin123
