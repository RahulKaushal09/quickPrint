# Where the browser reaches the API. On Vercel set these in Project Settings > Environment Variables
# and redeploy, because NEXT_PUBLIC_ values are built into the site.
# Production: https://api.seedhaprint.in
NEXT_PUBLIC_API_URL=http://localhost:4100

# Public address of this website, used for SEO links, sharing previews and the sitemap.
# Production: https://seedhaprint.in
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# WhatsApp number for the home page buttons: country code + number, digits only.
NEXT_PUBLIC_WHATSAPP_NUMBER=919872556259
